.app {
  padding: 24rpx;
}

/* 头部 */
.app-header {
  display: flex;
  align-items: center;
  margin: 6rpx 0 16rpx;
}

.logo-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #dde3ec;
  padding: 5rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.header-text {
  flex: 1;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  font-size: 26rpx;
  color: #6b7686;
  margin-top: 2rpx;
}

/* 功能页签 */
.tabbar {
  display: flex;
  border-bottom: 2rpx solid #eef1f6;
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #9aa7bc;
  position: relative;
}

.tab.on {
  color: #1e5eff;
}

.tab.on::after {
  content: "";
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: #1e5eff;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 6rpx rgba(31, 39, 51, 0.05);
}

.card-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #1748c9;
  margin-bottom: 14rpx;
}

/* 表单 */
.form-grid {
  display: flex;
  flex-wrap: wrap;
}

.form-grid .field {
  width: 50%;
  padding: 0 8rpx 14rpx;
  box-sizing: border-box;
}

.form-grid.three .field {
  width: 33.33%;
}

.form-grid.two .field {
  width: 50%;
}

.label {
  font-size: 28rpx;
  color: #6b7686;
  margin-bottom: 6rpx;
}

input,
.picker-value {
  width: 100%;
  padding: 10rpx 14rpx;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  font-size: 33rpx;
  background: #fff;
  box-sizing: border-box;
  min-height: 62rpx;
}

.picker-value {
  display: flex;
  align-items: center;
}

/* 形态切换 */
.shape-tabs {
  display: flex;
  gap: 12rpx;
  margin: 6rpx 0 12rpx;
}

.shape-btn {
  flex: 1;
  text-align: center;
  padding: 8rpx 0 6rpx;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  color: #1e5eff;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shape-btn.active {
  background: #eef3ff;
  border-color: #1e5eff;
}

.shape-text {
  font-size: 29rpx;
  font-weight: 600;
  color: #6b7686;
}

.shape-btn.active .shape-text {
  color: #1e5eff;
}

/* 形态简笔图（3D 线框图标） */
.shape-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

/* 管材模式切换 */
.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6b7686;
  background: #fff;
}

.mode-btn.active {
  background: #eef3ff;
  border-color: #1e5eff;
  color: #1e5eff;
}

/* 计算按钮 */
.calc-btn {
  width: 100%;
  padding: 18rpx 0;
  background: #1e5eff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 37rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  line-height: 1.6;
}

.calc-btn::after {
  border: none;
}

/* 结果 */
.result {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #dde3ec;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
}

.result-item {
  width: 50%;
  box-sizing: border-box;
  padding: 0 10rpx 20rpx;
}

.result-item view {
  text-align: center;
}

.result-item {
  background: #f7faff;
  border: 1rpx solid #e3eaf8;
  border-radius: 12rpx;
  padding: 14rpx 10rpx;
  margin: 0 10rpx 12rpx;
  width: calc(50% - 20rpx);
}

.result-label {
  font-size: 26rpx;
  color: #6b7686;
  margin-bottom: 4rpx;
}

.result-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #1748c9;
}

.result-unit {
  font-size: 26rpx;
  color: #6b7686;
  margin-top: 2rpx;
}

.formula {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7686;
  background: #f5f7fb;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: Menlo, Consolas, monospace;
}

/* 复制按钮 */
.ghost-btn {
  margin-top: 10rpx;
  padding: 12rpx 0;
  background: #fff;
  border: 1rpx solid #1e5eff;
  color: #1e5eff;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.ghost-btn::after {
  border: none;
}

/* 单件重量可编辑框（反算入口） */
.result-input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  font-size: 48rpx;
  font-weight: 800;
  color: #1748c9;
  text-align: center;
}

.result-input.edited {
  color: #f08c00;
}

.solve-weight-item {
  border-style: dashed;
}

/* 反算结果提示（蓝色加粗） */
.solve-msg {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #eef3ff;
  border: 1rpx solid #c9d8ff;
  color: #1e5eff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
}

/* 提醒性提示（醒目橙色） */
.solve-msg.warn {
  background: #fff2e0;
  border: 1.5rpx solid #ffc78f;
  color: #e8590c;
  font-size: 31rpx;
  font-weight: 800;
}

/* 页脚 */
.app-footer {
  text-align: center;
  padding: 14rpx 0 28rpx;
}

.slogan {
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: linear-gradient(90deg, #1e5eff, #7aa5ff 50%, #1e5eff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #1e5eff;
}

.footer-note {
  font-size: 24rpx;
  color: #6b7686;
  margin-top: 24rpx;
}
