.app {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部（与首页统一） */
.app-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 6rpx 0 16rpx;
}

.logo-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.header-text .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b2a4a;
}

.header-text .subtitle {
  font-size: 26rpx;
  color: #6b7686;
  margin-top: 2rpx;
}

/* 卡片（与首页统一） */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 6rpx rgba(31, 39, 51, 0.05);
}

.card-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #1748c9;
  margin-bottom: 14rpx;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.form-grid .field {
  width: 50%;
  padding: 0 8rpx 14rpx;
  box-sizing: border-box;
}

.field .label {
  font-size: 28rpx;
  color: #6b7686;
  margin-bottom: 6rpx;
}

.field input {
  border: 1.5rpx solid #c4cedb;
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  font-size: 33rpx;
  color: #1b2a4a;
  background: #fff;
  min-height: 62rpx;
  box-sizing: border-box;
  width: 100%;
}

/* 测算按钮（与首页统一） */
.calc-btn {
  background: #1e5eff;
  color: #fff;
  font-size: 37rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  border-radius: 12rpx;
  padding: 18rpx 0;
  line-height: 1.6;
}

.calc-btn::after {
  border: none;
}

.calc-btn:active {
  opacity: 0.85;
}

/* 切割类型切换（与首页模式按钮统一） */
.cut-type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cut-type-btn {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
  font-weight: 600;
  color: #6b7686;
}

.cut-type-btn.active {
  background: #eef3ff;
  border-color: #1e5eff;
  color: #1e5eff;
}

/* 反算目标块数（橙色） */
.field input.edited {
  color: #f08c00;
}

/* 板材 3D 模型示意 */
.plate-model {
  position: relative;
  height: 250rpx;
  background: #fbfcff;
  border: 1rpx dashed #dce4f0;
  border-radius: 12rpx;
  margin: 4rpx 0 14rpx;
  overflow: hidden;
}

.pm-img {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 300rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
}

.pm-dim {
  position: absolute;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e5eff;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #c9d8ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

.pm-l {
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}

.pm-w {
  top: 12rpx;
  left: 16rpx;
}

.pm-t {
  top: 50%;
  right: 10rpx;
  transform: translateY(-50%);
}

/* 反算结果提示（蓝色加粗，与首页统一） */
.solve-msg {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #eef3ff;
  border: 1rpx solid #c9d8ff;
  color: #1e5eff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
}

/* 提醒性提示（醒目橙色） */
.solve-msg.warn {
  background: #fff2e0;
  border: 1.5rpx solid #ffc78f;
  color: #e8590c;
  font-size: 31rpx;
  font-weight: 800;
}

/* 结果 */
.cut-count {
  font-size: 32rpx;
  color: #1b2a4a;
  margin-bottom: 12rpx;
}

.cut-num {
  color: #1e5eff;
  font-size: 48rpx;
  font-weight: 800;
}

.cut-target {
  font-size: 26rpx;
  color: #6b7686;
  font-weight: 400;
  margin-left: 8rpx;
}

.cut-meta {
  font-size: 26rpx;
  color: #6b7686;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

/* 图例 */
.cut-legend {
  display: flex;
  gap: 30rpx;
  margin: 16rpx 0 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6b7686;
}

.legend-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  background: #f8fafc;
}

.legend-fwd {
  border: 3rpx solid #3a66d8;
}

.legend-rot {
  border: 3rpx dashed #f08c00;
}

.legend-clamp {
  background: #b8bec9;
}

.legend-line {
  width: 26rpx;
  height: 36rpx;
  border-right: 3rpx solid #d8dee9;
  box-sizing: border-box;
}

/* 画布 */
.cut-canvas {
  width: 100%;
  border: 1rpx solid #dce4f0;
  border-radius: 12rpx;
  background: #fbfcff;
}

/* 页脚（与首页统一） */
.app-footer {
  text-align: center;
  padding: 14rpx 0 28rpx;
}

.slogan {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34rpx;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 4rpx;
  background: linear-gradient(90deg, #1e5eff, #7aa5ff 50%, #1e5eff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #1e5eff;
}

.footer-note {
  font-size: 24rpx;
  color: #6b7686;
  margin-top: 24rpx;
}

/* 输入引导占位文字（更醒目） */
.input-ph {
  color: #8f9db3;
  font-size: 30rpx;
  font-weight: 400;
}
