.app {
  max-width: 750rpx;
  margin: 0 auto;
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.app-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0 20rpx;
}

.logo-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
}

.header-text .title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1b2a4a;
}

.header-text .subtitle {
  font-size: 24rpx;
  color: #6b7686;
  margin-top: 4rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(30, 94, 255, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1b2a4a;
  margin-bottom: 24rpx;
}

.form-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-grid.two .field {
  flex: 1;
}

.field .label {
  font-size: 24rpx;
  color: #6b7686;
  margin-bottom: 10rpx;
}

.field input {
  border: 1rpx solid #dce4f0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  color: #1b2a4a;
  background: #f8fafc;
}

/* 测算按钮 */
.calc-btn {
  margin-top: 12rpx;
  background: #1e5eff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 22rpx 0;
}

.calc-btn::after {
  border: none;
}

.calc-btn:active {
  opacity: 0.85;
}

/* 反算目标块数（橙色） */
.field input.edited {
  color: #f08c00;
}

/* 反算结果提示（蓝色加粗） */
.solve-msg {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #eef3ff;
  border: 1rpx solid #c9d8ff;
  color: #1e5eff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

/* 提醒性提示（橙色） */
.solve-msg.warn {
  background: #fff4e6;
  border-color: #ffd9a8;
  color: #f08c00;
}

/* 结果 */
.cut-count {
  font-size: 30rpx;
  color: #1b2a4a;
  margin-bottom: 12rpx;
}

.cut-num {
  color: #1e5eff;
  font-size: 52rpx;
  font-weight: 800;
}

.cut-meta {
  font-size: 24rpx;
  color: #6b7686;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

/* 图例 */
.cut-legend {
  display: flex;
  gap: 30rpx;
  margin: 18rpx 0 14rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #6b7686;
}

.legend-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  background: #f8fafc;
}

.legend-fwd {
  border: 3rpx solid #3a66d8;
}

.legend-rot {
  border: 3rpx dashed #f08c00;
}

/* 画布 */
.cut-canvas {
  width: 100%;
  border: 1rpx solid #dce4f0;
  border-radius: 12rpx;
  background: #fbfcff;
}

/* 页脚 */
.app-footer {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.slogan {
  font-size: 26rpx;
  font-weight: 700;
  font-style: italic;
  color: #1e5eff;
  text-shadow: 0 0 10rpx rgba(30, 94, 255, 0.35);
}

.footer-note {
  font-size: 20rpx;
  color: #9aa7bc;
  margin-top: 8rpx;
}
